Option Explicit

' Використання в Excel: =HoroshopToHTML(F2)
Public Function HoroshopToHTML(ByVal inputText As String) As String
    Dim sourceLines As Variant
    Dim result As String
    Dim pendingText As String
    Dim line As String
    Dim itemText As String
    Dim headingText As String
    Dim prefixText As String
    Dim lineNumber As Long
    Dim pendingType As Long
    Dim currentListType As Long
    Dim newListType As Long

    ' Після оновлення VBA-коду формула повинна перерахуватися, навіть якщо F2 не змінювалася.
    Application.Volatile True

    If Len(Trim$(inputText)) = 0 Then Exit Function

    sourceLines = Split(NormalizeText(inputText), vbLf)

    For lineNumber = LBound(sourceLines) To UBound(sourceLines)
        line = NormalizeLine(CStr(sourceLines(lineNumber)))

        If Len(line) = 0 Then
            FlushPending result, pendingText, pendingType, currentListType

        ElseIf GetBoldHeading(line, headingText) Or GetMarkdownHeading(line, headingText) Then
            FlushPending result, pendingText, pendingType, currentListType
            CloseList result, currentListType
            result = result & "<h2>" & LinkifyText(headingText) & "</h2>" & vbLf

        ElseIf IsSectionTitle(line) Then
            If SplitInlineSectionTitle(line, prefixText, headingText) Then
                If pendingType = 0 And Len(pendingText) > 0 Then
                    pendingText = pendingText & " " & prefixText
                    FlushPending result, pendingText, pendingType, currentListType
                Else
                    FlushPending result, pendingText, pendingType, currentListType
                    CloseList result, currentListType
                    result = result & "<p>" & LinkifyText(prefixText) & "</p>" & vbLf
                End If
                CloseList result, currentListType
                result = result & "<p><strong>" & LinkifyText(headingText) & "</strong></p>" & vbLf
            Else
                FlushPending result, pendingText, pendingType, currentListType
                CloseList result, currentListType
                result = result & "<p><strong>" & LinkifyText(line) & "</strong></p>" & vbLf
            End If

        Else
            newListType = GetListItem(line, itemText)

            If newListType > 0 Then
                ' Якщо короткий заголовок опинився в кінці попереднього пункту,
                ' відокремлюємо його перед початком наступного пункту.
                If pendingType > 0 And SplitTrailingSectionTitle(pendingText, prefixText, headingText) Then
                    pendingText = prefixText
                    FlushPending result, pendingText, pendingType, currentListType
                    CloseList result, currentListType
                    result = result & "<p><strong>" & LinkifyText(headingText) & "</strong></p>" & vbLf
                Else
                    FlushPending result, pendingText, pendingType, currentListType
                End If

                pendingText = itemText
                pendingType = newListType

            ElseIf Len(result) = 0 And Len(pendingText) = 0 _
                And IsLikelyMainTitle(line) And HasTextAfter(sourceLines, lineNumber) Then
                result = result & "<h2>" & LinkifyText(line) & "</h2>" & vbLf

            ElseIf Len(pendingText) = 0 Then
                pendingText = line
                pendingType = 0

            Else
                ' Це перенос по ширині: приєднуємо рядок до абзацу або пункту списку.
                pendingText = pendingText & " " & line
            End If
        End If
    Next lineNumber

    FlushPending result, pendingText, pendingType, currentListType
    CloseList result, currentListType
    HoroshopToHTML = Trim$(result)
End Function

Private Function NormalizeText(ByVal value As String) As String
    value = Replace(value, "_x000D_", vbLf)
    value = Replace(value, vbCrLf, vbLf)
    value = Replace(value, vbCr, vbLf)
    value = Replace(value, ChrW(160), " ")
    value = Replace(value, "&nbsp;", " ")
    value = Replace(value, "&bull;", " * ")
    value = Replace(value, "&#8226;", " * ")
    value = Replace(value, "&#x2022;", " * ")
    value = Replace(value, "&middot;", " * ")
    value = Replace(value, "&#183;", " * ")
    value = Replace(value, "&mdash;", "—")
    value = Replace(value, "&ndash;", "–")
    value = Replace(value, Chr$(92) & "*", "*")
    value = Replace(value, ChrW(&H2022) & " ", vbLf & "* ")
    NormalizeText = NormalizeBulletMarkers(value)
End Function

' Приводить маркери списку з копійованих описів до єдиного вигляду "* ".
Private Function NormalizeBulletMarkers(ByVal value As String) As String
    Dim result As String
    Dim position As Long
    Dim symbol As String

    position = 1
    Do While position <= Len(value)
        symbol = Mid$(value, position, 1)

        If IsBulletSymbol(symbol) And IsBulletPosition(value, position) Then
            If Len(result) > 0 And Right$(result, 1) <> vbLf Then result = result & vbLf
            result = result & "* "
            position = position + 1

            Do While position <= Len(value) And IsInlineSpace(Mid$(value, position, 1))
                position = position + 1
            Loop
        Else
            result = result & symbol
            position = position + 1
        End If
    Loop

    NormalizeBulletMarkers = result
End Function

Private Function IsBulletSymbol(ByVal value As String) As Boolean
    Select Case value
        Case "*", "-", "•", "◦", "▪", "▫", "●", "○", "◉", "‣", "⁃", "∙", "·", _
            "►", "▶", "➢", "➤", "➔", "✓", "✔"
            IsBulletSymbol = True
    End Select
End Function

Private Function IsBulletPosition(ByVal value As String, ByVal position As Long) As Boolean
    Dim previousSymbol As String
    Dim nextSymbol As String

    If position > 1 Then previousSymbol = Mid$(value, position - 1, 1)
    If position < Len(value) Then nextSymbol = Mid$(value, position + 1, 1)

    IsBulletPosition = (position = 1 Or IsInlineSpace(previousSymbol)) _
        And (position = Len(value) Or IsInlineSpace(nextSymbol))
End Function

Private Function IsInlineSpace(ByVal value As String) As Boolean
    IsInlineSpace = value = " " Or value = vbTab Or value = vbCr Or value = vbLf
End Function

Private Function NormalizeLine(ByVal value As String) As String
    value = Replace(value, vbTab, " ")
    value = Trim$(value)

    Do While InStr(value, "  ") > 0
        value = Replace(value, "  ", " ")
    Loop

    NormalizeLine = value
End Function

Private Sub FlushPending(ByRef result As String, ByRef pendingText As String, _
    ByRef pendingType As Long, ByRef currentListType As Long)

    If Len(pendingText) = 0 Then Exit Sub

    If pendingType = 0 Then
        CloseList result, currentListType
        result = result & "<p>" & LinkifyText(pendingText) & "</p>" & vbLf
    Else
        EnsureList result, currentListType, pendingType
        result = result & "<li>" & LinkifyText(pendingText) & "</li>" & vbLf
    End If

    pendingText = vbNullString
    pendingType = 0
End Sub

' Повертає 1 для маркованого <ul>, 2 для нумерованого <ol> або 0.
Private Function GetListItem(ByVal value As String, ByRef itemText As String) As Long
    Dim marker As String
    Dim separatorPosition As Long
    Dim numberPart As String

    itemText = vbNullString
    If Len(value) < 2 Then Exit Function

    marker = Left$(value, 1)
    If (marker = "*" Or marker = "-" Or marker = "•" Or marker = "–" Or marker = "—") _
        And Mid$(value, 2, 1) = " " Then
        itemText = Trim$(Mid$(value, 2))
        If Len(itemText) > 0 Then GetListItem = 1
        Exit Function
    End If

    separatorPosition = InStr(value, ".")
    If separatorPosition = 0 Or separatorPosition > 5 Then
        separatorPosition = InStr(value, ")")
    End If

    If separatorPosition > 1 And separatorPosition <= 5 Then
        numberPart = Left$(value, separatorPosition - 1)
        If IsDigitsOnly(numberPart) And Mid$(value, separatorPosition + 1, 1) = " " Then
            itemText = Trim$(Mid$(value, separatorPosition + 1))
            If Len(itemText) > 0 Then GetListItem = 2
        End If
    End If
End Function

Private Function IsDigitsOnly(ByVal value As String) As Boolean
    Dim position As Long
    Dim symbol As String

    If Len(value) = 0 Then Exit Function

    For position = 1 To Len(value)
        symbol = Mid$(value, position, 1)
        If symbol < "0" Or symbol > "9" Then Exit Function
    Next position

    IsDigitsOnly = True
End Function

Private Function GetMarkdownHeading(ByVal value As String, ByRef headingText As String) As Boolean
    Dim position As Long

    headingText = vbNullString
    If Left$(value, 1) <> "#" Then Exit Function

    position = 1
    Do While Mid$(value, position, 1) = "#"
        position = position + 1
    Loop

    If position <= 2 Or Mid$(value, position, 1) <> " " Then Exit Function
    headingText = Trim$(Mid$(value, position + 1))
    GetMarkdownHeading = Len(headingText) > 0
End Function

' Markdown-виділення **Заголовок:** у вихідному тексті є назвою розділу.
Private Function GetBoldHeading(ByVal value As String, ByRef headingText As String) As Boolean
    headingText = vbNullString
    If Len(value) < 5 Then Exit Function
    If Left$(value, 2) <> "**" Or Right$(value, 2) <> "**" Then Exit Function

    headingText = Trim$(Mid$(value, 3, Len(value) - 4))
    GetBoldHeading = Len(headingText) > 0
End Function

Private Function IsSectionTitle(ByVal value As String) As Boolean
    IsSectionTitle = Right$(value, 1) = ":" _
        And InStr(1, value, "http://", vbTextCompare) = 0 _
        And InStr(1, value, "https://", vbTextCompare) = 0
End Function

' Обробляє "... опис. Особливості:" як абзац і окремий заголовок.
Private Function SplitInlineSectionTitle(ByVal value As String, ByRef prefixText As String, _
    ByRef headingText As String) As Boolean

    Dim separatorPosition As Long
    Dim candidate As String

    prefixText = vbNullString
    headingText = vbNullString
    If Len(value) <= 70 Or Not IsSectionTitle(value) Then Exit Function

    separatorPosition = InStrRev(Left$(value, Len(value) - 1), " ")
    If separatorPosition = 0 Then Exit Function

    candidate = Mid$(value, separatorPosition + 1)
    If Not StartsWithUppercaseLetter(candidate) Then Exit Function

    prefixText = Trim$(Left$(value, separatorPosition - 1))
    headingText = candidate
    SplitInlineSectionTitle = Len(prefixText) > 0
End Function

' Обробляє "... Фігурка. Характеристики фігурок" перед наступним пунктом.
Private Function SplitTrailingSectionTitle(ByVal value As String, ByRef itemText As String, _
    ByRef headingText As String) As Boolean

    Dim separatorPosition As Long
    Dim candidate As String

    itemText = vbNullString
    headingText = vbNullString
    separatorPosition = InStrRev(value, ". ")
    If separatorPosition = 0 Then Exit Function

    candidate = Trim$(Mid$(value, separatorPosition + 2))
    If Len(candidate) = 0 Or Len(candidate) > 45 Then Exit Function
    If Not IsLikelyMainTitle(candidate) Then Exit Function

    itemText = Left$(value, separatorPosition)
    headingText = candidate
    SplitTrailingSectionTitle = True
End Function

Private Function StartsWithUppercaseLetter(ByVal value As String) As Boolean
    Dim firstSymbol As String

    If Len(value) = 0 Then Exit Function
    firstSymbol = Left$(value, 1)
    StartsWithUppercaseLetter = firstSymbol = UCase$(firstSymbol) _
        And firstSymbol <> LCase$(firstSymbol)
End Function

Private Function IsLikelyMainTitle(ByVal value As String) As Boolean
    IsLikelyMainTitle = Len(value) <= 70 _
        And InStr(value, ".") = 0 _
        And InStr(value, ",") = 0 _
        And InStr(value, ":") = 0 _
        And InStr(value, "!") = 0 _
        And InStr(value, "?") = 0
End Function

Private Function HasTextAfter(ByRef sourceLines As Variant, ByVal currentLine As Long) As Boolean
    Dim lineNumber As Long

    For lineNumber = currentLine + 1 To UBound(sourceLines)
        If Len(NormalizeLine(CStr(sourceLines(lineNumber)))) > 0 Then
            HasTextAfter = True
            Exit Function
        End If
    Next lineNumber
End Function

Private Sub EnsureList(ByRef result As String, ByRef currentListType As Long, ByVal requiredListType As Long)
    If currentListType = requiredListType Then Exit Sub

    CloseList result, currentListType
    If requiredListType = 1 Then
        result = result & "<ul>" & vbLf
    Else
        result = result & "<ol>" & vbLf
    End If
    currentListType = requiredListType
End Sub

Private Sub CloseList(ByRef result As String, ByRef currentListType As Long)
    If currentListType = 1 Then
        result = result & "</ul>" & vbLf
    ElseIf currentListType = 2 Then
        result = result & "</ol>" & vbLf
    End If
    currentListType = 0
End Sub

Private Function LinkifyText(ByVal value As String) As String
    Dim expression As Object
    Dim matches As Object
    Dim match As Object
    Dim result As String
    Dim sourcePosition As Long
    Dim urlText As String
    Dim trailingText As String

    On Error GoTo HtmlOnly

    Set expression = CreateObject("VBScript.RegExp")
    expression.Global = True
    expression.IgnoreCase = True
    expression.Pattern = "((https?://|www\.)[^\s<>]+)"
    Set matches = expression.Execute(value)

    sourcePosition = 1
    For Each match In matches
        result = result & HtmlEncode(Mid$(value, sourcePosition, match.FirstIndex + 1 - sourcePosition))
        urlText = RemoveTrailingUrlPunctuation(CStr(match.Value), trailingText)

        result = result & "<a href=" & Chr$(34) & HtmlEncode(NormalizeUrl(urlText)) _
            & Chr$(34) & " target=" & Chr$(34) & "_blank" & Chr$(34) _
            & " rel=" & Chr$(34) & "noopener noreferrer" & Chr$(34) & ">" _
            & HtmlEncode(urlText) & "</a>" & HtmlEncode(trailingText)
        sourcePosition = match.FirstIndex + match.Length + 1
    Next match

    LinkifyText = result & HtmlEncode(Mid$(value, sourcePosition))
    Exit Function

HtmlOnly:
    LinkifyText = HtmlEncode(value)
End Function

Private Function NormalizeUrl(ByVal value As String) As String
    If LCase$(Left$(value, 4)) = "www." Then
        NormalizeUrl = "https://" & value
    Else
        NormalizeUrl = value
    End If
End Function

Private Function RemoveTrailingUrlPunctuation(ByVal value As String, ByRef trailingText As String) As String
    Dim lastSymbol As String

    trailingText = vbNullString
    Do While Len(value) > 0
        lastSymbol = Right$(value, 1)
        If InStr(".,;:!?)]}""'", lastSymbol) = 0 Then Exit Do
        value = Left$(value, Len(value) - 1)
        trailingText = lastSymbol & trailingText
    Loop

    RemoveTrailingUrlPunctuation = value
End Function

Private Function HtmlEncode(ByVal value As String) As String
    value = Replace(value, "&", "&amp;")
    value = Replace(value, "<", "&lt;")
    value = Replace(value, ">", "&gt;")
    value = Replace(value, Chr$(34), "&quot;")
    value = Replace(value, "'", "&#39;")
    HtmlEncode = value
End Function
