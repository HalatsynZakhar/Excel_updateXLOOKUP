Function BlackList(cell As Range) As String
    Dim keywordList As Variant
    Dim i As Integer
    
    ' Список ключевых слов 30 09 2024 13 15
    keywordList = Array("Прих. накл. Пбн-0000000005 (06.02.23)", "Прих. накл. Пбн-0000000061 (11.07.23)", _
                        "Прих. накл. Пбн-0000000107 (29.02.24)", "Прих. накл. Пбн-0000000167 (20.06.24)", _
                        "Прих. накл. Пбн-0000000105 (28.02.24)", "Прих. накл. Пбн-0000000107 (29.02.24)", _
                        "Прих. накл. Пбн-0000000169 (24.06.24)", "Syma", "Прих. накл. Птн-0000000052 (13.10.21)", _
                        "Прих. накл. Пбн-0000000030 (10.01.22)", "Прих. накл. Пбн-0000000011 (23.03.23)", _
                        "Прих. накл. Пбн-0000000405 (17.11.21)")

    ' Проход по ключевым словам
    For i = LBound(keywordList) To UBound(keywordList)
        If InStr(cell.Value, keywordList(i)) > 0 Then
            ' Если найдено совпадение, возвращаем предупреждение
            BlackList = "!!!"
            Exit Function
        End If
    Next i
    
    ' Если совпадений не найдено, возвращаем пустое значение
    BlackList = ""
End Function