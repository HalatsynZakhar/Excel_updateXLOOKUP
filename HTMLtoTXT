Option Explicit

' Використання в Excel: =HTMLtoTXT(F2)
Public Function HTMLtoTXT(ByVal inputHTML As String) As String
    Dim cleanText As String

    Application.Volatile True
    If Len(Trim$(inputHTML)) = 0 Then Exit Function

    cleanText = CleanPreviousAttempts(inputHTML)
    cleanText = ConvertHtmlStructure(cleanText)
    HTMLtoTXT = FormatPlainText(cleanText)
End Function

' Прибирає сліди попередніх конвертацій: екрановані теги, HTML-сутності,
' поламані Markdown-посилання та поширене неправильне кодування символів.
Private Function CleanPreviousAttempts(ByVal value As String) As String
    Dim passNumber As Long

    value = Replace(value, vbCrLf, vbLf)
    value = Replace(value, vbCr, vbLf)
    value = Replace(value, Chr$(92) & "<", "<")
    value = Replace(value, Chr$(92) & ">", ">")
    value = Replace(value, Chr$(92) & "_", "_")

    ' Декодуємо вкладені сутності, наприклад &amp;bull; після повторної обробки.
    For passNumber = 1 To 3
        value = Replace(value, "&amp;", "&")
        value = Replace(value, "&nbsp;", " ")
        value = Replace(value, "&quot;", Chr$(34))
        value = Replace(value, "&#39;", "'")
        value = Replace(value, "&lt;", "<")
        value = Replace(value, "&gt;", ">")
        value = Replace(value, "&mdash;", "—")
        value = Replace(value, "&ndash;", "–")
        value = Replace(value, "&hellip;", "…")
        value = Replace(value, "&bull;", vbLf & "* ")
        value = Replace(value, "&#8226;", vbLf & "* ")
        value = Replace(value, "&#x2022;", vbLf & "* ")
        value = Replace(value, "&middot;", vbLf & "* ")
        value = Replace(value, "&#183;", vbLf & "* ")
    Next passNumber

    ' Відновлюємо символи, пошкоджені при неправильному декодуванні UTF-8.
    value = Replace(value, "вЂ”", "—")
    value = Replace(value, "вЂ“", "–")
    value = Replace(value, "вЂ¦", "…")
    value = Replace(value, "вЂ™", "’")
    value = Replace(value, "вЂњ", "“")
    value = Replace(value, "вЂќ", "”")

    value = Replace(value, Chr$(92) & "*", "*")
    value = NormalizeBrokenLinks(value)
    CleanPreviousAttempts = value
End Function

' Спочатку прибирає Markdown-обгортку URL, потім залишає з <a> лише адресу.
Private Function NormalizeBrokenLinks(ByVal value As String) As String
    value = RegexReplace(value, "\[(https?://[^\]\s]+)\]\([^\)]+\)", "$1")
    value = RegexReplace(value, "<a\b[^>]*\bhref\s*=\s*[""']?([^""'\s>]+)[^>]*>[\s\S]*?</a\s*>", "$1")
    NormalizeBrokenLinks = value
End Function

Private Function ConvertHtmlStructure(ByVal value As String) As String
    value = RegexReplace(value, "<br\s*/?\s*>", vbLf)
    value = RegexReplace(value, "</p\s*>", vbLf & vbLf)
    value = RegexReplace(value, "<p\b[^>]*>", vbNullString)
    value = RegexReplace(value, "<h[1-6]\b[^>]*>", vbLf)
    value = RegexReplace(value, "</h[1-6]\s*>", vbLf & vbLf)
    value = RegexReplace(value, "<ul\b[^>]*>|</ul\s*>", vbLf)
    value = RegexReplace(value, "<ol\b[^>]*>|</ol\s*>", vbLf)
    value = RegexReplace(value, "<li\b[^>]*>", vbLf & "* ")
    value = RegexReplace(value, "</li\s*>", vbLf)
    value = RegexReplace(value, "</?(strong|b|em|i)\b[^>]*>", vbNullString)
    value = RegexReplace(value, "<[^>]+>", vbNullString)
    ConvertHtmlStructure = value
End Function

Private Function RegexReplace(ByVal value As String, ByVal pattern As String, ByVal replacement As String) As String
    Dim expression As Object

    On Error GoTo UseOriginalText
    Set expression = CreateObject("VBScript.RegExp")
    expression.Global = True
    expression.IgnoreCase = True
    expression.Pattern = pattern
    RegexReplace = expression.Replace(value, replacement)
    Exit Function

UseOriginalText:
    RegexReplace = value
End Function

' Формує читабельний текст: зберігає маркери, робить відступи перед секціями
' та відокремлює заголовок, який випадково потрапив у кінець пункту.
Private Function FormatPlainText(ByVal value As String) As String
    Dim lines As Variant
    Dim result As String
    Dim line As String
    Dim bodyText As String
    Dim headerText As String
    Dim lineNumber As Long
    Dim previousWasBlank As Boolean

    lines = Split(value, vbLf)

    For lineNumber = LBound(lines) To UBound(lines)
        line = NormalizeLine(CStr(lines(lineNumber)))

        If Len(line) = 0 Then
            If Len(result) > 0 Then previousWasBlank = True

        ElseIf SplitTrailingHeader(line, bodyText, headerText) Then
            AppendPlainLine result, bodyText, False
            AppendPlainLine result, headerText, True
            previousWasBlank = False

        Else
            AppendPlainLine result, line, previousWasBlank Or IsSectionTitle(line)
            previousWasBlank = False
        End If
    Next lineNumber

    Do While InStr(result, vbLf & vbLf & vbLf) > 0
        result = Replace(result, vbLf & vbLf & vbLf, vbLf & vbLf)
    Loop

    FormatPlainText = Trim$(result)
End Function

Private Sub AppendPlainLine(ByRef result As String, ByVal value As String, ByVal addBlankBefore As Boolean)
    If Len(value) = 0 Then Exit Sub

    If Len(result) > 0 Then
        If addBlankBefore And Right$(result, 2) <> vbLf & vbLf Then result = result & vbLf
        result = result & vbLf
    End If
    result = result & value
End Sub

' Розділяє рядки виду "* Опис. Характеристики:" та "... Відеоогляд:".
Private Function SplitTrailingHeader(ByVal value As String, ByRef bodyText As String, _
    ByRef headerText As String) As Boolean

    Dim separatorPosition As Long
    Dim candidate As String

    bodyText = vbNullString
    headerText = vbNullString
    If Right$(value, 1) <> ":" Then Exit Function

    separatorPosition = InStrRev(value, ". ")
    If separatorPosition = 0 Then Exit Function

    candidate = Trim$(Mid$(value, separatorPosition + 2))
    If Len(candidate) = 0 Or Len(candidate) > 70 Then Exit Function
    If Not StartsWithUppercaseLetter(candidate) Then Exit Function

    bodyText = Left$(value, separatorPosition)
    headerText = candidate
    SplitTrailingHeader = True
End Function

Private Function IsSectionTitle(ByVal value As String) As Boolean
    IsSectionTitle = Right$(value, 1) = ":" And Left$(value, 2) <> "* "
End Function

Private Function StartsWithUppercaseLetter(ByVal value As String) As Boolean
    Dim firstSymbol As String

    If Len(value) = 0 Then Exit Function
    firstSymbol = Left$(value, 1)
    StartsWithUppercaseLetter = firstSymbol = UCase$(firstSymbol) _
        And firstSymbol <> LCase$(firstSymbol)
End Function

Private Function NormalizeLine(ByVal value As String) As String
    value = Replace(value, vbTab, " ")
    value = Trim$(value)

    Do While InStr(value, "  ") > 0
        value = Replace(value, "  ", " ")
    Loop

    NormalizeLine = value
End Function

' Функція для обробки всього стовпця.
Public Sub ConvertHTMLColumnToText()
    Dim worksheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long
    Dim sourceColumn As String
    Dim targetColumn As String

    sourceColumn = "A"
    targetColumn = "B"
    Set worksheet = ActiveSheet
    lastRow = worksheet.Cells(worksheet.Rows.Count, sourceColumn).End(xlUp).Row

    For rowNumber = 2 To lastRow
        If Len(Trim$(CStr(worksheet.Range(sourceColumn & rowNumber).Value))) > 0 Then
            worksheet.Range(targetColumn & rowNumber).Value = _
                HTMLtoTXT(CStr(worksheet.Range(sourceColumn & rowNumber).Value))
        End If
    Next rowNumber

    MsgBox "Конвертація завершена. Оброблено рядків: " & (lastRow - 1), vbInformation
End Sub
